<Project Sdk="Microsoft.NET.Sdk">

  <!-- RL Map Loader for Linux (Avalonia). Shares all map/swap logic with the Windows app via RLMapLoader.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rl-map-loader</AssemblyName>
    <RootNamespace>RLMapLoader.Linux</RootNamespace>
    <Product>RL Map Loader</Product>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- app-menu icon written by the self-install -->
    <EmbeddedResource Include="../linux/rl-map-loader.png" LogicalName="rl-map-loader.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RLMapLoader.Core\RLMapLoader.Core.csproj" />
  </ItemGroup>

</Project>
