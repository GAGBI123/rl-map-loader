<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <!-- palette (matches the Windows app) -->
            <Color x:Key="BgColor">#0A0D14</Color>
            <SolidColorBrush x:Key="Bg" Color="#0A0D14"/>
            <SolidColorBrush x:Key="Surface" Color="#121826"/>
            <SolidColorBrush x:Key="Surface2" Color="#182033"/>
            <SolidColorBrush x:Key="Surface3" Color="#202A40"/>
            <SolidColorBrush x:Key="Line" Color="#26304A"/>
            <SolidColorBrush x:Key="Text" Color="#EEF2FA"/>
            <SolidColorBrush x:Key="Muted" Color="#8C97AD"/>
            <SolidColorBrush x:Key="Blue" Color="#2D7FF9"/>
            <SolidColorBrush x:Key="BlueLight" Color="#5BA0FF"/>
            <SolidColorBrush x:Key="Orange" Color="#FF8A1F"/>
            <SolidColorBrush x:Key="Green" Color="#22C55E"/>
            <SolidColorBrush x:Key="GreenSoft" Color="#1A22C55E"/>
            <SolidColorBrush x:Key="BlueSoft" Color="#222D7FF9"/>
            <SolidColorBrush x:Key="OrangeSoft" Color="#22FF8A1F"/>
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#2D7FF9" Offset="0"/>
                <GradientStop Color="#4F6BFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TeamLine" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#2D7FF9" Offset="0"/>
                <GradientStop Color="#7C5CFF" Offset="0.5"/>
                <GradientStop Color="#FF8A1F" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#16213A" Offset="0"/>
                <GradientStop Color="#111827" Offset="0.6"/>
                <GradientStop Color="#1B1426" Offset="1"/>
            </LinearGradientBrush>

            <!-- icons (Material Design Icons, Apache 2.0) -->
            <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
            <StreamGeometry x:Key="IconCog">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
            <StreamGeometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
            <StreamGeometry x:Key="IconUndo">M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z</StreamGeometry>
            <StreamGeometry x:Key="IconOpen">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>
            <StreamGeometry x:Key="IconAlert">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconKeyboard">M19,10H17V8H19M19,13H17V11H19M16,10H14V8H16M16,13H14V11H16M16,17H8V15H16M7,10H5V8H7M7,13H5V11H7M8,11H10V13H8M8,8H10V10H8M11,11H13V13H11M11,8H13V10H11M20,5H4C2.89,5 2,5.89 2,7V17A2,2 0 0,0 4,19H20A2,2 0 0,0 22,17V7C22,5.89 21.1,5 20,5Z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <StreamGeometry x:Key="IconMap">M15,19L9,16.89V5L15,7.11M20.5,3C20.44,3 20.39,3 20.34,3L15,5.1L9,3L3.36,4.9C3.15,4.97 3,5.15 3,5.38V20.5A0.5,0.5 0 0,0 3.5,21C3.55,21 3.61,21 3.66,20.97L9,18.9L15,21L20.64,19.1C20.85,19 21,18.85 21,18.62V3.5A0.5,0.5 0 0,0 20.5,3Z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- text -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- buttons -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A3552"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1A2236"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="BorderBrush" Value="#3D8BFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#4A90FF"/>
        <Setter Property="BorderBrush" Value="#6AA5FF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#2A1A22"/>
        <Setter Property="BorderBrush" Value="#5A2633"/>
        <Setter Property="Foreground" Value="#FFB4B4"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A1E29"/>
        <Setter Property="BorderBrush" Value="#7A3141"/>
        <Setter Property="Foreground" Value="#FFC8C8"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <!-- sort pills -->
    <Style Selector="RadioButton.pill">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" CornerRadius="7" Padding="12,6" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.pill:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.pill:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.pill:checked /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
    </Style>

    <!-- inputs -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource BlueLight}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="34,9,10,9"/>
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
    </Style>

    <!-- progress -->
    <Style Selector="ProgressBar.slim">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TeamLine}"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
    </Style>

    <!-- lists without default chrome -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- map cards -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="9"/>
        <Setter Property="Width" Value="252"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.025)"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
    </Style>
    <Style Selector="Border.card.active">
        <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
    </Style>
    <Style Selector="Border.hoverLayer">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card:pointerover Border.hoverLayer">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Button.star">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="#B30A0D14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.card:pointerover Button.star, Button.star.on">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.star PathIcon">
        <Setter Property="Foreground" Value="#DDE3EE"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>
    <Style Selector="Button.star.on PathIcon">
        <Setter Property="Foreground" Value="{StaticResource Orange}"/>
    </Style>

    <!-- small badge -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="#CC0A0D14"/>
    </Style>

    <!-- overlay rows -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.row">
        <Setter Property="Background" Value="#2A2D7FF9"/>
    </Style>

    <!-- settings drawer -->
    <Style Selector="Border.drawer">
        <Setter Property="RenderTransform" Value="translateX(480px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.drawer.open">
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
    </Style>

    <!-- toast -->
    <Style Selector="Border.toast">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateY(20px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.toast.shown">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
    </Style>
</Styles>
