<Window x:Class="RLMapLoader.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RL Map Loader" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Border Height="3" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{StaticResource TeamLine}"/>
            <StackPanel Margin="24,24,24,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconText" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Orange}"
                               VerticalAlignment="Center" Margin="0,0,10,0" Text="&#xE7BA;"/>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="13.5" Foreground="#C3CBDA" TextWrapping="Wrap" LineHeight="20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource BaseButton}" Margin="0,0,10,0" Click="Secondary_Click" IsCancel="True"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="Primary_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
