<Window x:Class="RLMapLoader.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:RLMapLoader.Models"
        Title="RL Map Loader – Overlay" Width="420" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" FontFamily="Segoe UI"
        Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="Row" DataType="{x:Type m:MapItem}">
            <Border x:Name="row" CornerRadius="11" Padding="8" Margin="0,0,0,4" Background="Transparent" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="54">
                        <Rectangle RadiusX="7" RadiusY="7" Fill="{Binding PlaceholderBrush}"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold" Foreground="#F7FFFFFF"
                                   TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="44"
                                   Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Rectangle RadiusX="7" RadiusY="7" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE735;" FontSize="10" Foreground="{StaticResource Orange}"
                                       Margin="0,1,5,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       MaxWidth="210"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Green}"
                            VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"
                            ToolTip="Loaded in Underpass">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE73E;" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#12FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#2A2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="14" CornerRadius="18" Background="#F50C111B" BorderBrush="#2EFFFFFF" BorderThickness="1"
            Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="3" VerticalAlignment="Top" CornerRadius="18,18,0,0" Background="{StaticResource TeamLine}"/>

            <!-- header (drag to move) -->
            <Grid Grid.Row="0" Margin="16,14,10,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Map Loader" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource Surface3}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip="Press again to hide">
                        <TextBlock Text="{Binding HotkeyText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Background="Transparent" BorderBrush="Transparent" Width="32" Height="32"
                            Content="&#xE8A7;" FontSize="12" ToolTip="Open the full app" Click="OpenMain_Click" Cursor="Hand"/>
                    <Button Style="{StaticResource IconButton}" Background="Transparent" BorderBrush="Transparent" Width="32" Height="32"
                            Content="&#xE8BB;" FontSize="10" ToolTip="Close (Esc)" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- status -->
            <Border Grid.Row="1" Margin="16,12,16,0" CornerRadius="10" Padding="11,8" Background="{StaticResource Surface2}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusShort}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="12"
                            Foreground="#FFB4B4" Command="{Binding RestoreCommand}" Content="Restore"
                            Visibility="{Binding IsCustomActive, Converter={StaticResource BoolVis}}"
                            ToolTip="Put the original Underpass back"/>
                </Grid>
            </Border>

            <!-- search -->
            <Grid Grid.Row="2" Margin="16,10,16,6">
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Type to search…"
                         Text="{Binding OverlaySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE721;" Foreground="{StaticResource Muted}" FontSize="13"
                           VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- list -->
            <ListBox x:Name="List" Grid.Row="3" Margin="10,2,6,0" Style="{StaticResource PlainListBox}"
                     ItemsSource="{Binding OverlayView}" SelectedItem="{Binding OverlaySelected}"
                     ItemTemplate="{StaticResource Row}" MouseDoubleClick="List_MouseDoubleClick"
                     VirtualizingPanel.ScrollUnit="Pixel"/>
            <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                       TextAlignment="Center" Margin="24" TextWrapping="Wrap"
                       Visibility="{Binding OverlayView.Count, Converter={StaticResource NullVis}, ConverterParameter=invert}"
                       Text="No maps match. Set up your folders in the full app (button at the top right)."/>

            <!-- footer -->
            <StackPanel Grid.Row="4" Margin="16,8,16,14">
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border x:Name="FullscreenHint" CornerRadius="9" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed"
                        Background="{StaticResource OrangeSoft}">
                    <TextBlock FontSize="12" Foreground="#FFC58F" TextWrapping="Wrap" LineHeight="17">
                        Rocket League is in <Bold>Fullscreen</Bold> mode, so it was minimized to show this and comes back when you
                        close it. Set <Bold>Settings → Video → Display Mode → Borderless</Bold> to pick maps on top of the game.
                    </TextBlock>
                </Border>
                <Border x:Name="Flash" CornerRadius="9" Padding="10,7" Margin="0,0,0,10" Opacity="0" Visibility="Collapsed"
                        Background="{StaticResource GreenSoft}">
                    <TextBlock x:Name="FlashText" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>
                <Button x:Name="LoadButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="16,11"
                        Click="LoadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Load selected map"/>
                    </StackPanel>
                </Button>
                <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="#6B7690"
                           Text="↑ ↓ pick  ·  Enter load  ·  Esc close  ·  then Free Play → Underpass"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
